NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role Supabase — utilisée uniquement côté serveur par le
# webhook WhatsApp (contourne le RLS pour identifier le bon gestionnaire
# et écrire les messages/contacts avant authentification).
SUPABASE_SERVICE_ROLE_KEY=

# Identifiants Twilio (validation de signature webhook + téléchargement des
# médias entrants). Requis pour le webhook WhatsApp AkilAI.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Clé API OpenAI — utilisée par le webhook pour générer les réponses de
# l'assistant WhatsApp (GPT-4o) et transcrire les messages vocaux (Whisper).
OPENAI_API_KEY=

# Numéro d'envoi WhatsApp global — fonctionnalité héritée de l'ancien
# produit (quittances/relances de loyer, /api/whatsapp/quittance,
# /api/whatsapp/relance, /api/cron/relances-quotidiennes), non utilisée par
# AkilAI. Le webhook AkilAI répond automatiquement depuis le numéro WhatsApp
# Business exact de chaque compte (parametres_compte.numero_whatsapp), donc
# CETTE VARIABLE N'EST PAS REQUISE pour AkilAI. Ne la renseigner que si les
# endpoints hérités ci-dessus sont réactivés.
TWILIO_WHATSAPP_FROM=

# Secret partagé avec le scheduler externe (ex: cron-job.org) pour protéger
# /api/cron/relances-quotidiennes. Fonctionnalité héritée de l'ancien
# produit (relances de loyer), non utilisée par AkilAI. Optionnel.
CRON_SECRET=

# Clé maîtresse pour le chiffrement AES-256-GCM des clés API des
# intégrations (src/lib/integrations/chiffrement.ts) — 32 octets encodés en
# base64. Générer une nouvelle valeur avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ne jamais réutiliser la même valeur entre environnements, ne jamais la
# committer. La perdre rend toutes les clés API déjà stockées indéchiffrables.
ENCRYPTION_KEY=

# Identifiants Google Cloud OAuth pour la connexion Google Calendar
# (src/lib/integrations/google-calendar.ts). URI de redirection configurée
# côté Google : https://akilai-senegal.vercel.app/api/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Embedded Signup (Tech Provider Twilio) — permet au client final
# de connecter son propre numéro WhatsApp Business en gardant son
# historique (mode coexistence), voir
# src/app/dashboard/parametres/WhatsappEmbeddedSignup.tsx. En attente de la
# Configuration ID Meta et de l'approbation Twilio Tech Provider : tant que
# ces deux variables sont absentes, le bouton "Connecter mon numéro
# WhatsApp Business" reste masqué et seul le champ manuel est utilisable.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
