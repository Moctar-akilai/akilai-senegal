NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role Supabase — utilisée uniquement côté serveur par le
# webhook WhatsApp (contourne le RLS pour identifier le bon gestionnaire
# et écrire les messages/contacts avant authentification).
SUPABASE_SERVICE_ROLE_KEY=

# Identifiants Twilio (envoi/réception WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1415XXXXXXX

# Clé API Anthropic — utilisée par le webhook pour générer les réponses
# de l'assistant WhatsApp.
ANTHROPIC_API_KEY=

# Optionnel : modèle Claude à utiliser pour l'assistant (défaut : claude-opus-5).
# Pour un assistant WhatsApp à fort volume, un modèle plus économique comme
# claude-sonnet-5 peut être préférable — ajuster selon le budget.
ANTHROPIC_MODEL=claude-opus-5

# Secret partagé avec le scheduler externe (ex: cron-job.org) pour protéger
# /api/cron/relances-quotidiennes. Fonctionnalité héritée de l'ancien
# produit (relances de loyer), non utilisée par AkilAI. Optionnel.
CRON_SECRET=
