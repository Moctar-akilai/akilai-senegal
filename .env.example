NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role Supabase — utilisée uniquement côté serveur par le cron
# de relances (contourne le RLS pour traiter tous les gestionnaires).
SUPABASE_SERVICE_ROLE_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1415XXXXXXX

# Secret partagé avec le scheduler externe (ex: cron-job.org) pour protéger
# /api/cron/relances-quotidiennes. Optionnel mais recommandé en production.
CRON_SECRET=
